programa {
  funcao inicio() {
    real prova1,prova2,trabalho,media
    escreva("digite a nota da prova 1")
    leia (prova1)
    escreva("digite a nota da prova 2")
    leia (prova2)
    escreva("digite a nota do trabalho")
    leia(trabalho)
    media= (prova1*2+prova2*3+ trabalho*4)/(2+3+4)
    escreva("media_final=", media) 

  }
}
